# Copy to .env and fill in. NEVER commit .env.

# 1) Google Gemini API key (100% Free!) — get yours at https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# 2) Telegram bot token — talk to @BotFather, /newbot, paste the token here.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# --- Optional (sane defaults applied if omitted) ---
# Runtime model. gemini-3.6-flash = fast & free default; gemini-3.6-pro for heavy reasoning.
# KIRANA_MODEL=gemini-3.6-flash
# KIRANA_MODEL=gemini-3.6-pro

# Storage paths (defaults are project-local; mount these as volumes in Docker).
# KIRANA_DB_PATH=./data/kirana.db
# KIRANA_ARTIFACTS_DIR=./artifacts_out

# Max tool-calling turns per message.
# KIRANA_MAX_TURNS=24

# Scheduled jobs (IST). Weekly analysis deck + daily khata reminders are sent to
# every chat that has used the bot, unless you pin a single owner chat here.
# KIRANA_OWNER_CHAT_ID=123456789
# KIRANA_DECK_WEEKDAY=1   # 0=Sun … 1=Mon
# KIRANA_DECK_HOUR=9      # weekly deck at 09:00 IST
# KIRANA_REMINDER_HOUR=10 # daily khata reminder at 10:00 IST
